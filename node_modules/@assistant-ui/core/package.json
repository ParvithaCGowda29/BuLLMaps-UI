{
  "name": "@assistant-ui/core",
  "version": "0.3.28",
  "description": "Framework-agnostic core runtime for assistant-ui",
  "keywords": [
    "assistant",
    "ai",
    "chat",
    "runtime",
    "framework-agnostic"
  ],
  "author": "AgentbaseAI Inc.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "default": "./dist/store/index.js"
    },
    "./store/internal": {
      "types": "./dist/store/internal.d.ts",
      "default": "./dist/store/internal.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/internal": {
      "types": "./dist/react/internal.d.ts",
      "default": "./dist/react/internal.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react/index.d.ts"
      ],
      "internal": [
        "./dist/internal.d.ts"
      ],
      "store": [
        "./dist/store/index.d.ts"
      ],
      "store/internal": [
        "./dist/store/internal.d.ts"
      ],
      "react/internal": [
        "./dist/react/internal.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "assistant-stream": "^0.3.51",
    "nanoid": "^6.0.2"
  },
  "optionalDevDependencies": {
    "@assistant-ui/x-generative-compiler": ">=0.0.3"
  },
  "peerDependencies": {
    "@assistant-ui/store": "^0.3.20",
    "@assistant-ui/tap": "^0.9.23",
    "@types/react": "*",
    "react": "^18 || ^19",
    "assistant-cloud": "^0.2.1"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "assistant-cloud": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@assistant-ui/store": "0.3.20",
    "@assistant-ui/tap": "0.9.23",
    "@assistant-ui/vite": "0.0.21",
    "@assistant-ui/x-buildutils": "0.0.30",
    "@assistant-ui/x-react18": "0.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "assistant-cloud": "0.2.7",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://www.assistant-ui.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assistant-ui/assistant-ui.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/assistant-ui/assistant-ui/issues"
  },
  "scripts": {
    "build": "aui-build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test:peer-react18": "vitest run --config vitest.peer-react18.config.ts",
    "test:types:peer-react18": "aui-react18-types",
    "test:react-compiler": "vitest run --config vitest.react-compiler.config.ts",
    "test:watch": "vitest"
  }
}